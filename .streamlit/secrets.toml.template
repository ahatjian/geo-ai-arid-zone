# Streamlit Secrets 配置模板
# ⚠️ 请勿提交此文件到 Git! 已在 .gitignore 中排除
#
# 在 Streamlit Cloud 中通过 Web 界面设置:
#   App Settings → Secrets
#   或通过 Streamlit Cloud CLI 管理

# ============================================
# DeepSeek AI (智能查询 + 分析解读, 必须配置才能启用 AI)
# ============================================
# 注册地址: https://platform.deepseek.com/
# 复制本文件为 secrets.toml 并填入真实 Key:
#   cp secrets.toml.template secrets.toml
# 或在 Streamlit Cloud → App Settings → Secrets 中设置
DEEPSEEK_API_KEY = "your-deepseek-api-key"
# 可选: 指定模型 (默认 deepseek-chat) 与温度
# DEEPSEEK_MODEL = "deepseek-chat"
# DEEPSEEK_TEMPERATURE = "0.3"

# ============================================
# Planetary Computer API (可选, 提高稳定性)
# ============================================
# 注册地址: https://planetarycomputer.microsoft.com/account/request
# 免费申请, 无需绑卡
[pc_api]
# subscription_key = "your-subscription-key-here"

# ============================================
# ESA Copernicus (可选, 提高下载速度)
# ============================================
# 注册地址: https://dataspace.copernicus.eu/
# 免费注册
[copernicus]
# username = "your-username"
# password = "your-password"

# ============================================
# USGS EarthExplorer (可选, Landsat 下载)
# ============================================
# 注册地址: https://ers.cr.usgs.gov/register/
# 免费注册
[usgs]
# username = "your-username"
# password = "your-password"
